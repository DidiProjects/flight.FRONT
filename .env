# Relativo de propósito: o dev server faz proxy de /flight para a API. Front e
# API na mesma origem = sem CORS em dev, e `npm run start:exposed` funciona sem
# reconfigurar nada. Em produção o CI sobrescreve com a URL absoluta.
VITE_API_URL=/flight
# Endereço desta máquina na tailnet. É por ele que o app é acessado — no PC e no
# celular, dentro ou fora de casa. `npm run start:exposed` lê daqui o host e a
# porta do bind.
VITE_APP_URL=http://100.77.40.44:3001

VITE_AUTHOR_NAME=Your Name
VITE_AUTHOR_GITHUB=https://github.com/yourusername
VITE_FEEDBACK_EMAIL=feedback@example.com
